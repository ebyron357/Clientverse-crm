# ClientVerse frontend environment (public build-time configuration)
# Copy to .env for local development. Never put secrets here.

# Base URL of the backend API (no trailing slash). All calls are prefixed with /api.
REACT_APP_BACKEND_URL="http://localhost:8001"

# Google OAuth login URL. Omit to hide the "Continue with Google" button.
# REACT_APP_GOOGLE_AUTH_URL="https://auth.example.com"
