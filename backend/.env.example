# ClientVerse backend environment (safe placeholders — copy to .env and fill real values)

# MongoDB connection (local dev)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="clientverse"

# Allowed CORS origin(s) and the public frontend URL
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Auth — generate a long random hex string for JWT_SECRET (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-hex-string"

# Seeded admin/owner account (change before any real use)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Emergent Universal LLM key (used for evidence-backed AI). Obtain from Emergent profile.
EMERGENT_LLM_KEY="your-emergent-llm-key"

# Secret bearer token for platform cron endpoints (commitment SLA + integration sync)
WEBHOOK_CRON_SECRET="replace-with-a-long-random-string"

# Master key for encrypting integration credentials at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENC_KEY="replace-with-a-fernet-key"

# Google OAuth (Gmail + Calendar read-only). Create a Web OAuth client in Google Cloud Console.
# Authorized redirect URI must be: <PUBLIC_BACKEND_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Stripe read-only adapter (test mode). Provided by the Emergent environment.
STRIPE_API_KEY="sk_test_..."
