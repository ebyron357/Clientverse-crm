# ClientVerse backend environment (safe placeholders — copy to .env and fill real values)
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Required for core production operation (secret backend configuration)
# ---------------------------------------------------------------------------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="clientverse"
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
# Use production for a managed deployment. In that mode fictional demo records
# are not created unless explicitly opted in (which should never be necessary).
APP_ENV="development"
# Public URL of this API (used to derive Google OAuth redirect when GOOGLE_REDIRECT_URI is unset)
PUBLIC_BACKEND_URL="http://localhost:8001"

# Auth — generate a long random hex string (>=32 chars): `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-hex-string"
# Disposable local/dev ONLY. Never set in production.
# ALLOW_INSECURE_JWT="1"

# Seeded admin/owner account (change before any real use; operator-generated secret)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Local/test convenience only. Production defaults to false and must remain false.
SEED_DEMO_DATA="true"

# Secret bearer token for platform cron endpoints (commitment SLA + integration sync + digests)
WEBHOOK_CRON_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Required only for optional integrations (secret backend configuration)
# ---------------------------------------------------------------------------
# Master key for encrypting integration credentials at rest — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENC_KEY="replace-with-a-fernet-key"

# Google OAuth (Gmail + Calendar read-only). Create a Web OAuth client in Google Cloud Console.
# Authorized redirect URI must be: <PUBLIC_BACKEND_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Stripe test-mode adapter. Prefer a restricted `rk_test_...` key with only the
# Account read, Customer read, Invoice read, Subscription read, and PaymentIntent
# write permissions required by the implemented lifecycle.
STRIPE_API_KEY=""
# Per-endpoint Stripe webhook signing secret (`whsec_...`) for:
#   <PUBLIC_BACKEND_URL>/api/integrations/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Evidence-backed AI (Emergent Universal LLM key). Omit to disable AI features.
EMERGENT_LLM_KEY=""

# Transactional email via Emergent email API. Omit to keep digests in-app only.
EMERGENT_EMAIL_KEY=""
EMAIL_FROM_NAME="ClientVerse"

# ---------------------------------------------------------------------------
# Required only for testing / local demo seed (not production identities)
# ---------------------------------------------------------------------------
# Leave BOTH unset in production: the demo member is only seeded when both are set.
DEMO_MEMBER_EMAIL="demo.member@clientverse.io"
DEMO_MEMBER_PASSWORD="Member2026!"
